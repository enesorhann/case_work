<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#C2410C">
    <title>@ViewData["Title"] · Mini DPP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap">
    <style>
        /* React arayüzüyle aynı renkler ve yazı tipleri (açık / koyu tema cihaz ayarından) */
        :root { --bg:#FAF7F3; --bg2:#F1EAE2; --surface:#FFFFFF; --surface2:#FBF8F4; --text:#1F1A16; --muted:#6A5F56; --border:#E8DED3;
                --primary:#C2410C; --on-primary:#FFFFFF; --soft:#FFEDD5; --soft-ink:#9A3412; --ok:#15803D; --ok-soft:#DCFCE7; --seg2:#FDBA74;
                --shadow:0 1px 2px rgba(60,30,10,.06),0 8px 24px -12px rgba(60,30,10,.18); }
        @@media (prefers-color-scheme: dark) {
            :root { --bg:#110E0C; --bg2:#1E1915; --surface:#1A1613; --surface2:#221C18; --text:#F6F0EA; --muted:#B0A396; --border:#342B24;
                    --primary:#FB923C; --on-primary:#1F1206; --soft:#3A2214; --soft-ink:#FDBA74; --ok:#4ADE80; --ok-soft:#12301E; --seg2:#7C2D12;
                    --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px -14px rgba(0,0,0,.7); }
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--text); font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif; -webkit-font-smoothing: antialiased; }
        a { color: var(--primary); }
        .mono { font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace; }
        .wrap { max-width: 860px; margin: 0 auto; padding: 0 16px; }
        .hdr { border-bottom: 1px solid var(--border); }
        .hdr .wrap { display: flex; align-items: center; gap: 12px; min-height: 64px; flex-wrap: wrap; }
        .brand { display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-weight: 800; font-size: 17px; }
        .brand-mark { width: 34px; height: 34px; border-radius: 10px; background: var(--primary); color: var(--on-primary); display: grid; place-items: center; }
        .brand small { display: block; font-size: 12px; font-weight: 500; color: var(--muted); }
        main { padding: 24px 0 64px; }
        .card { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; box-shadow: var(--shadow); overflow: hidden; margin-bottom: 16px; }
        .head { padding: 24px 24px 0; }
        .eyebrow { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--soft-ink); background: var(--soft); padding: 6px 10px; border-radius: 999px; }
        .badge { display: inline-block; font-size: 12.5px; font-weight: 700; padding: 6px 10px; border-radius: 999px; color: var(--ok); background: var(--ok-soft); }
        .badge.role { color: var(--muted); background: var(--bg2); }
        .badge.role.auth { color: var(--soft-ink); background: var(--soft); }
        h1 { font-size: clamp(26px, 6vw, 36px); font-weight: 800; letter-spacing: -.035em; line-height: 1.1; margin: 12px 0 6px; }
        .meta { color: var(--muted); font-size: 14px; display: flex; gap: 8px; flex-wrap: wrap; }
        .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; padding: 20px 24px; }
        .fact { padding: 14px; border-radius: 14px; background: var(--surface2); border: 1px solid var(--border); }
        .l { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
        .v { font-size: 16px; font-weight: 700; margin-top: 6px; }
        .sect { padding: 0 24px 20px; }
        .comp { display: flex; height: 12px; border-radius: 99px; overflow: hidden; background: var(--bg2); gap: 2px; margin: 10px 0; }
        .comp .c1 { background: var(--primary); } .comp .c2 { background: var(--seg2); }
        .legend { display: flex; gap: 14px; font-size: 13px; color: var(--muted); font-weight: 600; flex-wrap: wrap; }
        .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; }
        .carbon { margin: 0 24px 24px; padding: 18px; border-radius: 16px; display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
        .carbon.open { background: var(--soft); }
        .carbon.locked { background: var(--bg2); border: 1px dashed var(--border); }
        .carbon .tx { flex: 1 1 180px; } .carbon .tx b { display: block; } .carbon .tx span { font-size: 13.5px; color: var(--muted); }
        .carbon .big { font-size: 28px; font-weight: 800; color: var(--soft-ink); }
        table { border-collapse: collapse; width: 100%; }
        th, td { text-align: left; padding: 10px 24px; border-top: 1px solid var(--border); font-size: 14.5px; }
        th { color: var(--muted); font-weight: 600; width: 40%; }
        .qr { display: flex; gap: 20px; align-items: center; padding: 20px 24px; flex-wrap: wrap; }
        .qr img { background: #fff; padding: 8px; border-radius: 14px; border: 1px solid var(--border); }
        .links { display: flex; gap: 10px; flex-wrap: wrap; margin: 4px 0 16px; }
        .btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 12px; font-weight: 700; font-size: 14px; text-decoration: none; border: 1px solid var(--border); background: var(--surface); color: var(--text); }
        .btn.p { background: var(--primary); border-color: var(--primary); color: var(--on-primary); }
        details { margin-top: 8px; } summary { cursor: pointer; font-weight: 600; color: var(--muted); min-height: 44px; display: flex; align-items: center; }
        pre { background: var(--surface2); border: 1px solid var(--border); border-radius: 14px; padding: 14px; overflow-x: auto; font-size: 12.5px; }
        .foot { border-top: 1px solid var(--border); padding: 20px 0; font-size: 13px; color: var(--muted); }
    </style>
</head>
<body>
    <header class="hdr">
        <div class="wrap">
            <a class="brand" href="/">
                <span class="brand-mark" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="3"></rect><path d="M8 8h3v3H8z"></path><path d="M14 8h2M14 11h2M8 15h8"></path></svg></span>
                <span>Mini DPP<small>Dijital Ürün Pasaportu</small></span>
            </a>
        </div>
    </header>
    <main class="wrap">
        @RenderBody()
    </main>
    <footer class="foot"><div class="wrap">Mini DPP · ESG Next teknik değerlendirme çalışması</div></footer>
</body>
</html>
